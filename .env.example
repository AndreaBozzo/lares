# Lares configuration. Copy to .env and edit.
#
#   cp .env.example .env && $EDITOR .env
#
# Docker Compose loads this natively and the shell scripts source it, so every
# line must stay plain KEY=VALUE -- no shell syntax, no spaces around "=".
#
# NO SECRETS HERE. Names, paths and topology only. Credentials (restic
# password, object-storage keys, notification topic) live in root-only files
# under /etc/lares/. See docs/disaster-recovery.md.
#
# Anything derivable is deliberately NOT here. The repository path comes from
# the scripts' own location; the restic repository lives with its credentials
# in /etc/lares/backup.env. A setting that can disagree with reality is worse
# than no setting, because it is only consulted when something has gone wrong.

# ---------------------------------------------------------------- identity --
# Unprivileged user owning the storage tree and running the containers.
PI_USER=changeme
# Used in the SMB server string, and as the Tailscale hostname during setup.
PI_HOSTNAME=lares
# Container timezone.
TZ=Europe/Rome

# ----------------------------------------------------------------- storage --
# Single root for everything. /srv/lares is a documented invariant of this
# project: the diagrams, docs and backup include-list all assume it. Change it
# only if you are prepared to change those too.
#
# If this lives on the same disk the OS boots from, there is no redundancy and
# the offsite backup is your only real copy.
STORAGE=/srv/lares
APPDATA=/srv/lares/appdata

# Must match the owner of STORAGE. If these disagree, containers write files
# the SMB share cannot modify, and it only surfaces much later.
PUID=1000
PGID=1000

# ----------------------------------------------------------------- network --
# Interface the SMB share binds to. Never the Docker bridge.
PI_IFACE=eth0
# LAN gateway. Used as the "is the internet reachable" ping monitor.
PI_GATEWAY=192.168.1.1

# Tailscale MagicDNS name, from `tailscale status`. Admin UIs are published
# only via `tailscale serve` at this name, never on the LAN.
#
# NOT publicly resolvable, and containers cannot resolve it -- their DNS goes
# to a public resolver. Service-to-service URLs must therefore use Docker
# service names (http://ntfy). Getting this wrong yields a notification channel
# that silently reaches nobody.
PI_TAILNET_NAME=changeme.example-tailnet.ts.net
