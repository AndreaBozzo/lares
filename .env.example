# Lares configuration. Copy to .env and edit.
#
#   cp .env.example .env && $EDITOR .env
#
# Docker Compose loads this file natively and the shell scripts source it, so
# every line must stay plain KEY=VALUE -- no shell syntax, no spaces around "=".
#
# NO SECRETS HERE. This file holds names, paths and topology only. Credentials
# (restic password, object-storage keys, notification topics) live in root-only
# files under /etc/lares/. See docs/backup-and-recovery.md.

# ---------------------------------------------------------------- identity --
# Unprivileged user that owns the storage tree and runs the containers.
PI_USER=changeme
PI_HOSTNAME=lares
PI_TIMEZONE=Europe/Rome
TZ=Europe/Rome

# Absolute path to this checkout on the host. bootstrap.sh renders this into
# the systemd units, which cannot expand variables themselves.
LARES_DIR=/home/changeme/lares

# ----------------------------------------------------------------- storage --
# One root for everything. If this lives on the same disk the OS boots from,
# there is no redundancy and the offsite backup is your only real copy.
PI_STORAGE=/srv/lares
STORAGE=/srv/lares
APPDATA=/srv/lares/appdata

# Must match the owner of STORAGE. If these disagree, containers write files
# the share cannot modify, and the mismatch only shows up much later.
PUID=1000
PGID=1000

# ----------------------------------------------------------------- network --
# Interface the SMB share binds to. Never the Docker bridge.
PI_IFACE=eth0
# LAN gateway, used as the "is the internet reachable" ping monitor.
PI_GATEWAY=192.168.1.1

# Tailscale MagicDNS name, from `tailscale status`. Admin UIs are published
# only via `tailscale serve` at this name, never on the LAN.
#
# IMPORTANT: this name is NOT publicly resolvable, and containers cannot
# resolve it -- their DNS goes to a public resolver. Service-to-service URLs
# must therefore use Docker service names (http://ntfy), not this. Getting it
# wrong yields a notification channel that silently reaches nobody.
PI_TAILNET_NAME=changeme.example-tailnet.ts.net

# ------------------------------------------------------------------ backup --
# restic repository: b2:<bucket>:<path>, sftp:, rest:, s3:. Credentials do NOT
# belong here -- they go in /etc/lares/backup.env (root, 0600).
PI_RESTIC_REPO=b2:changeme-bucket:lares
